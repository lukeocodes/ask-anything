# ---------------------------------------------------------------------------
# ask-anything — environment
# Copy to .env for local dev. In production these are set on the deployment.
# ---------------------------------------------------------------------------

# --- Identity ---------------------------------------------------------------
# Name of this deployment (MCP server name, answer prompts). e.g. "Ask Acme"
ASK_NAME=ask-anything
# One line on what the configured sources cover — the prompts introduce the
# engine as "You are <ASK_NAME>, <ASK_DESCRIPTION>."
# e.g. "a knowledge engine over Acme's repositories and docs"
ASK_DESCRIPTION=a grounded knowledge engine over the configured sources

# --- Core API ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Postgres (pgvector). Local dev matches docker-compose.yml.
DATABASE_URL=postgres://ask:ask@localhost:5432/ask

# --- Auth (static API keys) -------------------------------------------------
# Hardcoded CSV baked into the deployment env. Redeploy to rotate.
# Format: key:label:scope:visibility  (comma-separated entries)
#   scope      = read | write | admin
#   visibility = public | private   (default public)
# A `private` key is the "secret" that unlocks internal knowledge — a private
# request sees public AND private. A `public` key only ever sees public docs.
API_KEYS=devkey123:local-dev:admin:private,publicwidget:public-widget:read:public

# --- AI (LLM) ---------------------------------------------------------------
# Answer/cheap model provider: anthropic (Anthropic, or an Anthropic-compatible
# gateway such as opencode zen) | vertex (Gemini on Google Vertex AI).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AI SDK provider baseURL — INCLUDE the version path (provider appends /messages).
# Anthropic direct: leave blank. opencode zen: https://opencode.ai/zen/v1
ANTHROPIC_BASE_URL=
# Model used to answer questions (capable). Configurable.
ASK_ANSWER_MODEL=claude-opus-4-8
# Cheap/fast model for summaries, titles, normalisation, question clustering.
ASK_CHEAP_MODEL=claude-haiku-4-5
# Google Vertex AI (LLM / embeddings / rerank when a provider is set to vertex).
# Auth is ADC: `gcloud auth application-default login` locally, the runtime SA
# on Cloud Run. Project is required for any vertex provider.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
# Embedding provider + model for vector retrieval.
#   vertex : Gemini embeddings on Vertex AI (see GOOGLE_VERTEX_*).
#   voyage : hosted. voyage-4-lite is free up to 200M tokens (voyage-3 is NOT).
#   openai : hosted OpenAI-compatible (text-embedding-3-*). Set OPENAI_API_KEY.
#   local  : any OpenAI-compatible embeddings server (free, in-house). Examples:
#            Ollama   -> EMBEDDINGS_BASE_URL=http://localhost:11434/v1, EMBEDDINGS_MODEL=nomic-embed-text
#            TEI      -> EMBEDDINGS_BASE_URL=http://localhost:8080/v1,  EMBEDDINGS_MODEL=BAAI/bge-large-en-v1.5
# EMBEDDING_DIM must match the model AND the pgvector column — change it and you
# must regenerate the migration and re-embed (voyage-4-lite/voyage-3 = 1024;
# nomic-embed-text = 768; bge-large = 1024).
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=voyage-4-lite
EMBEDDINGS_BASE_URL=
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=
# Cross-encoder rerank over the candidate pool — the answerability gate. On by
# default; with no reranker key it degrades to a round-robin merge and the gate
# falls back to FASTPATH_MIN_CONFIDENCE. Scores need VOYAGE_API_KEY (or vertex).
RERANK_ENABLED=true
# voyage | vertex (Vertex AI Ranking API).
RERANK_PROVIDER=voyage
RERANK_MODEL=rerank-2.5-lite
# Top-hit rerank relevance at/above which the DB fast path answers directly;
# below it, ask hands off to the index-searching agent. Not calibrated to confidence — tune
# against the eval set.
RELEVANCE_ANSWER_THRESHOLD=0.35
# Freshness floor (decayed confidence) for the fast path, and the answerability
# fallback when no reranker ran. Mirrors the 0.4 stale threshold in decay.
FASTPATH_MIN_CONFIDENCE=0.4
# Max chars per document sent to the reranker (source bodies are unbounded).
RERANK_DOC_CHARS=1200
# Over-fetch multiplier: each source is gathered at limit x this into the pool.
RERANK_POOL_FACTOR=4

# Semantic answer cache (speed/cost). Repeat questions in the same visibility
# tier return a stored answer with no model call.
CACHE_ENABLED=true
CACHE_SIMILARITY=0.95
CACHE_TTL_HOURS=24

# Governance: allow private knowledge to reach third-party model/embedding APIs.
# When false, private requests are refused before any egress (self-host to enable).
PRIVATE_EGRESS_ALLOWED=true

# Ops guardrails.
RATE_LIMIT_PER_MINUTE=120
DAILY_COST_CAP_USD=0   # 0 = disabled

# --- Sources (registered records, ADR-0024) ---------------------------------
# Repos and sites are NOT configured here. Register them at runtime; the two
# shipped adapters (ADR-0020) are public git repositories and websites:
#   ask sources add https://github.com/acme/sdk            # a public git repo
#   ask sources add https://gitlab.com/acme/docs.git --branch main --include "docs/**"
#   ask sources add https://docs.example.com --crawl sitemap --visibility public
#   ask sources adapters                                    # what this deployment can index
# Cloning is plain `git clone --depth 1`; private repositories are not supported.
# Clone cache: <ASK_WORKDIR>/sources/<sourceId>. Deleting it forces a re-clone.
ASK_WORKDIR=~/.ask-anything
# Scheduler tick: runs every enabled source whose own schedule (or
# INDEX_DEFAULT_SCHEDULE) has fired since its last index. Empty disables.
INDEX_CRON=*/15 * * * *
# Per-source cron for sources registered without --schedule.
INDEX_DEFAULT_SCHEDULE=0 4 * * *
# Skip files larger than this (KB) in git sources.
INDEX_MAX_FILE_KB=512
# Cap on pages a --crawl sitemap source expands to.
INDEX_MAX_PAGES=500

# --- API clients ------------------------------------------------------------
# The stdio MCP proxy (@ask/mcp-stdio) and the management CLI (`ask`) call the
# hosted REST API with these.
ASK_API_URL=http://localhost:3000
ASK_API_KEY=devkey123

# --- Verify tick / decay ----------------------------------------
# Verify tick: items owned by review-trust adapters are re-checked upstream and
# changes become proposals. A no-op with only the shipped upstream-trust adapters.
MONITOR_CRON=0 */6 * * *
# Cron for symbolic decay recomputation.
DECAY_CRON=0 3 * * *
# Re-warm the answer cache for the most-asked questions (default: every 4h).
WARM_CACHE_CRON=30 */4 * * *
# Re-ask previously-unanswered questions now the KB has grown (default: daily
# 05:00, after the default source index). Empty string disables it.
BACKFILL_CRON=0 5 * * *
# On the answer path, cited items last verified more than this many hours ago
# are queued for a targeted re-verify against their source (0 disables).
REVERIFY_AGE_HOURS=168

# --- Logdrain (telemetry / logs to a target) --------------------------------
# Optional. HTTP endpoint that receives structured logs + usage events.
LOGDRAIN_URL=
LOGDRAIN_TOKEN=
